<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- TAB 1: HISTORY VIEW -->
    <LinearLayout
        android:id="@+id/layout_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Call Log History"
            android:textSize="20sp"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tv_empty_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:text="No call logs found."
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- TAB 2: ADD CALL FORM (SCROLLABLE) -->
    <ScrollView
        android:id="@+id/layout_add_entry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/main_text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Add Call Log"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/main_text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif"
                android:text="Call Type"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/main_text1" />

            <!-- Card Selectors for Call Type (Premium Look) -->
            <LinearLayout
                android:id="@+id/layout_type_selectors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/main_text2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Missed Card Selector -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_select_missed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#ECEFF1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <ImageView
                            android:id="@+id/img_select_missed"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/sym_call_missed" />
                        <TextView
                            android:id="@+id/tv_select_missed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Missed"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Outgoing Card Selector -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_select_outgoing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#ECEFF1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <ImageView
                            android:id="@+id/img_select_outgoing"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/sym_call_outgoing" />
                        <TextView
                            android:id="@+id/tv_select_outgoing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Outgoing"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Incoming Card Selector -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_select_incoming"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#ECEFF1"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <ImageView
                            android:id="@+id/img_select_incoming"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/sym_call_incoming" />
                        <TextView
                            android:id="@+id/tv_select_incoming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Incoming"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Input Fields Container -->
            <LinearLayout
                android:id="@+id/linearLayout_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/layout_type_selectors">

                <!-- 1. Number / Name direct input (Clean transparent vector ic_phone) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_number"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    android:hint="Phone Number / Contact Name"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="#546E7A"
                    app:endIconMode="clear_text">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2. Choose Date picker input (Clean transparent vector ic_calendar) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_date"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:hint="Select Date"
                    app:startIconDrawable="@drawable/ic_calendar"
                    app:startIconTint="#546E7A"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_today">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:text="" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3. Choose Time picker input (Clean transparent vector ic_clock) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_time"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:hint="Select Time"
                    app:startIconDrawable="@drawable/ic_clock"
                    app:startIconTint="#546E7A"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_recent_history">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:text="" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 4. Choose Duration picker input (Clean transparent vector ic_timer) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_duration"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:hint="Select Duration"
                    app:startIconDrawable="@drawable/ic_timer"
                    app:startIconTint="#546E7A"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_compass">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:text="" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Premium rounded Add button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_call_action"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="32dp"
                android:text="Add to Call Log"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_add"
                app:layout_constraintTop_toBottomOf="@id/linearLayout_fields"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:backgroundTint="#2563EB"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- TAB 3: STATISTICS DASHBOARD (ADVANCED - PAST 30 DAYS) -->
    <ScrollView
        android:id="@+id/layout_stats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Call Insights &amp; Analytics"
                android:textSize="20sp"
                android:textColor="@android:color/black"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Insights for the past 30 days"
                android:textSize="14sp"
                android:textColor="#546E7A"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp" />

            <!-- Quick Summary Dashboard Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#ECEFF1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FAFAFA">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="General Overview"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#546E7A"
                        android:layout_marginBottom="12dp" />

                    <!-- Total Calls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Call Logs"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <!-- Avg Call Duration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Avg. Call Duration"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_avg_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0s"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <!-- Most Contacted -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Most Contacted"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_most_contacted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="N/A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <!-- Missed Call Rate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Missed Call Rate"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_missed_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0%"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <!-- Peak Call Hour -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Peak Call Period"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_peak_hour"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="N/A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Call Counts Grid Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#ECEFF1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Call Type Breakdown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#546E7A"
                        android:layout_marginBottom="16dp" />

                    <!-- Missed Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="#D32F2F"
                            android:layout_marginRight="8dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Missed Calls"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_missed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#D32F2F" />
                    </LinearLayout>

                    <!-- Incoming Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="#388E3C"
                            android:layout_marginRight="8dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Incoming Calls"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_incoming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#388E3C" />
                    </LinearLayout>

                    <!-- Outgoing Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="#1976D2"
                            android:layout_marginRight="8dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Outgoing Calls"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_outgoing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1976D2" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Call Duration Analysis Card (Flat stroke, clean background) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#ECEFF1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FAFAFA">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Talk Time Analysis"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#F57F17"
                        android:layout_marginBottom="12dp" />

                    <!-- Incoming Duration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Incoming Duration"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_incoming_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0s"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <!-- Outgoing Duration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Outgoing Duration"
                            android:textSize="15sp"
                            android:textColor="#263238" />
                        <TextView
                            android:id="@+id/tv_stat_outgoing_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0s"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CFD8DC"
                        android:layout_marginBottom="12dp" />

                    <!-- Total Duration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Call Duration"
                            android:textSize="15sp"
                            android:textColor="#263238"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_stat_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 min"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#F57F17" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
   </ScrollView>

    <!-- BOTTOM NAVIGATION -->
